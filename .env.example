NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dataset_quality
DB_USER=root
DB_PASSWORD=changeme

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Python analysis
PYTHON_BIN=python
ANALYSIS_TIMEOUT_MS=60000

# Optional: created on startup if both are set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123
ADMIN_NAME=Admin

# CORS
CORS_ORIGIN=*
